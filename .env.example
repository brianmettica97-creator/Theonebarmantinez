# Copiar a .env (nunca subir .env al repositorio).
# Solo claves PÚBLICAS (anon). La service_role NUNCA va en el frontend.

# "demo" (datos de ejemplo, almacenados en el navegador si no hay Supabase) o "production"
VITE_APP_MODE=demo

# Proyecto Supabase (Settings > API). Dejar vacío para ejecutar la demo sin backend.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# URL pública final (solo producción; se usa para sitemap y Open Graph)
VITE_SITE_URL=

# Límite de imágenes subidas desde el panel (MB)
VITE_MAX_IMAGE_MB=5
